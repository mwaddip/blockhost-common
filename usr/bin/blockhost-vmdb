#!/usr/bin/python3
"""blockhost-vmdb — CLI wrapper around blockhost.vm_db.

Engines call this binary instead of spawning python3 -c "<inline-script>",
which avoids per-call interpreter startup + import cost (~50-150 ms each).
"""

import argparse
import json
import sys

from blockhost.vm_db import get_database


def cmd_mark_nft_minted(args):
    db = get_database()
    try:
        db.set_nft_minted(args.vm_name, args.token_id)
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 1
    return 0


def cmd_extend_expiry(args):
    db = get_database()
    vm = db.get_vm(args.vm_name)
    if vm is None:
        print(f"VM '{args.vm_name}' not found", file=sys.stderr)
        return 1
    old_status = vm.get("status", "unknown")
    try:
        db.extend_expiry(args.vm_name, args.days)
    except ValueError as e:
        print(str(e), file=sys.stderr)
        return 1
    print(f"Extended {args.vm_name} expiry by {args.days} days")
    if old_status == "suspended":
        print("NEEDS_RESUME")
    return 0


def cmd_get_vm(args):
    db = get_database()
    vm = db.get_vm(args.vm_name)
    if vm is None:
        print(f"VM '{args.vm_name}' not found", file=sys.stderr)
        return 1
    json.dump(vm, sys.stdout)
    sys.stdout.write("\n")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="blockhost-vmdb")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("mark-nft-minted", help="Record a minted NFT on a VM record")
    p.add_argument("vm_name")
    p.add_argument("token_id", type=int)
    p.set_defaults(func=cmd_mark_nft_minted)

    p = sub.add_parser("extend-expiry", help="Extend a VM's expiry by N days")
    p.add_argument("vm_name")
    p.add_argument("days", type=int)
    p.set_defaults(func=cmd_extend_expiry)

    p = sub.add_parser("get-vm", help="Print a VM record as JSON")
    p.add_argument("vm_name")
    p.set_defaults(func=cmd_get_vm)

    args = parser.parse_args()
    try:
        sys.exit(args.func(args))
    except Exception as e:
        print(str(e), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
