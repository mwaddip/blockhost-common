#!/usr/bin/python3
"""blockhost-network-hook — network-plugin dispatcher CLI.

Resolves a VM's ``network_mode`` from vm-db and forwards to the plugin
manifested at ``/etc/blockhost/network-modes.available/<mode>.json`` and
symlinked into ``/etc/blockhost/network-modes.enabled/``. Common ships
this dispatcher; mode-specific code (onion, broker, manual, none) lives
in plugins from the main repo / installer.

See ``facts/NETWORK_INTERFACE.md`` for the full contract.

Exit codes follow the convention in ``COMMON_INTERFACE.md §6a``:
  0 = success
  1 = expected failure (missing record, mode not enabled, plugin's own exit 1)
  2 = unexpected exception
Plugin commands' own exit codes are forwarded as-is.
"""

import argparse
import sys

from blockhost.network import (
    DispatchError,
    disable,
    dispatch_mode,
    dispatch_vm,
    enable,
    list_available,
    list_enabled,
    resolve_mode,
)


def cmd_public_address(args):
    return dispatch_vm("public-address", args.vm_name)


def cmd_push_vm_config(args):
    return dispatch_vm("push-vm-config", args.vm_name)


def cmd_cleanup(args):
    return dispatch_vm("cleanup", args.vm_name)


def cmd_pre_provision(args):
    return dispatch_mode(
        "pre-provision",
        args.mode,
        extra_argv=[args.plan_id],
        extra_env={"BH_PLAN_ID": args.plan_id},
    )


def cmd_mode(args):
    sys.stdout.write(resolve_mode(args.vm_name) + "\n")
    return 0


def cmd_list_available(args):
    for name in list_available():
        sys.stdout.write(name + "\n")
    return 0


def cmd_list_enabled(args):
    for name in list_enabled():
        sys.stdout.write(name + "\n")
    return 0


def cmd_enable(args):
    enable(args.mode)
    return 0


def cmd_disable(args):
    disable(args.mode)
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog="blockhost-network-hook",
        description="Dispatch network-layer operations to the plugin "
                    "registered for a VM's network_mode, and manage the "
                    "available/enabled set of network plugins.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser(
        "public-address",
        help="Print the publicly-routable address for a VM.",
    )
    p.add_argument("vm_name")
    p.set_defaults(func=cmd_public_address)

    p = sub.add_parser(
        "push-vm-config",
        help="Push mode-specific configuration into a VM (idempotent).",
    )
    p.add_argument("vm_name")
    p.set_defaults(func=cmd_push_vm_config)

    p = sub.add_parser(
        "cleanup",
        help="Release per-VM resources allocated by the plugin.",
    )
    p.add_argument("vm_name")
    p.set_defaults(func=cmd_cleanup)

    p = sub.add_parser(
        "pre-provision",
        help="Pre-allocate values for a plan (future; mode + plan id).",
    )
    p.add_argument("mode")
    p.add_argument("plan_id")
    p.set_defaults(func=cmd_pre_provision)

    p = sub.add_parser(
        "mode",
        help="Print the resolved network_mode for a VM (debugging).",
    )
    p.add_argument("vm_name")
    p.set_defaults(func=cmd_mode)

    p = sub.add_parser(
        "list-available",
        help="List installed network mode names (one per line).",
    )
    p.set_defaults(func=cmd_list_available)

    p = sub.add_parser(
        "list-enabled",
        help="List currently-enabled network mode names (one per line).",
    )
    p.set_defaults(func=cmd_list_enabled)

    p = sub.add_parser(
        "enable",
        help="Enable a network mode (creates a symlink in enabled/). "
             "Validates exclusive_with against currently-enabled modes.",
    )
    p.add_argument("mode")
    p.set_defaults(func=cmd_enable)

    p = sub.add_parser(
        "disable",
        help="Disable a network mode (removes the symlink in enabled/).",
    )
    p.add_argument("mode")
    p.set_defaults(func=cmd_disable)

    args = parser.parse_args()
    try:
        sys.exit(args.func(args))
    except DispatchError as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"{type(e).__name__}: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
